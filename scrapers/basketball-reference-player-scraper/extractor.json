{
  "name": "Basketball-Reference - player page",
  "description": "Basketball-Reference player pages (basketball-reference.com/players/<letter>/<id>.html): name, player id, headshot, bio lines (full name, position, shoots, height / weight, team, birth, college, draft, debut, experience), birth date and place, height, weight, honors (All-Star, MVP, titles), every regular-season row of the per-game stats table (season, age, team, league, position, games, minutes, shooting splits, rebounds, assists, steals, blocks, turnovers, fouls, points, awards), career and per-team per-game averages and career totals (games, minutes, points, rebounds, assists, steals, blocks).",
  "slug": "basketball-reference-player",
  "url": "https://www.basketball-reference.com/players/j/jamesle01.html",
  "method": "GET",
  "useProxy": true,
  "renderJavascript": false,
  "proxyCountry": "US",
  "category": "sports",
  "tags": [
    "basketball reference",
    "nba",
    "basketball",
    "player stats",
    "sports",
    "sports data"
  ],
  "visibility": "public",
  "extractorConfig": {
    "version": "v1.0",
    "fields": [
      {
        "name": "name",
        "selector": "#meta h1",
        "transforms": [
          "normalizeWhitespace"
        ],
        "required": true
      },
      {
        "name": "playerId",
        "selector": "link[rel=\"canonical\"][href]",
        "extract": "attributeValue",
        "attributeName": "href",
        "transforms": [
          {
            "after": "/players/"
          },
          {
            "after": "/"
          },
          {
            "before": ".html"
          }
        ]
      },
      {
        "name": "image",
        "selector": "#meta .media-item img[src]",
        "extract": "attributeValue",
        "attributeName": "src",
        "transforms": [
          "toAbsoluteUrl"
        ]
      },
      {
        "name": "bio",
        "selector": "#meta p",
        "isArray": true,
        "transforms": [
          "normalizeWhitespace",
          "compact"
        ],
        "textSeparator": ""
      },
      {
        "name": "birthDate",
        "selector": "#necro-birth[data-birth]",
        "extract": "attributeValue",
        "attributeName": "data-birth"
      },
      {
        "name": "birthPlace",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPaths": [
          "birthPlace"
        ]
      },
      {
        "name": "height",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPaths": [
          "height.value"
        ]
      },
      {
        "name": "weight",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPaths": [
          "weight.value"
        ]
      },
      {
        "name": "honors",
        "selector": "#bling li",
        "isArray": true,
        "transforms": [
          "normalizeWhitespace",
          "compact"
        ]
      },
      {
        "name": "seasons",
        "selector": "#per_game_stats tbody tr",
        "isArray": true,
        "extract": "innerHTML",
        "required": true,
        "subExtractor": {
          "fields": [
            {
              "name": "season",
              "selector": "th[data-stat=\"year_id\"]",
              "transforms": [
                "normalizeWhitespace"
              ],
              "required": true
            },
            {
              "name": "age",
              "selector": "td[data-stat=\"age\"]",
              "transforms": [
                "toNumber"
              ]
            },
            {
              "name": "team",
              "selector": "td[data-stat=\"team_name_abbr\"]",
              "transforms": [
                "normalizeWhitespace"
              ],
              "textSeparator": ""
            },
            {
              "name": "teamUrl",
              "selector": "td[data-stat=\"team_name_abbr\"] a[href]",
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                "toAbsoluteUrl"
              ]
            },
            {
              "name": "league",
              "selector": "td[data-stat=\"comp_name_abbr\"]",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "position",
              "selector": "td[data-stat=\"pos\"]",
              "transforms": [
                "normalizeWhitespace",
                "nullIfEmpty"
              ]
            },
            {
              "name": "games",
              "selector": "td[data-stat=\"games\"]",
              "transforms": [
                "toNumber"
              ]
            },

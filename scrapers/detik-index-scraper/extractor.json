{
  "name": "Detik.com - news index (latest news)",
  "description": "The latest-news index of a detik.com channel (news.detik.com/indeks, finance.detik.com/indeks, ...): per story the position, headline, link, image, publish time (Unix and WIB label) and relative time, plus the page title, current page and next-page link. Plain fetch through an Indonesian proxy. Also returns the sections of the channel navigation bar (Berita, Jabodetabek, Internasional, ...).",
  "slug": "detik-index",
  "url": "https://news.detik.com/indeks",
  "method": "GET",
  "useProxy": true,
  "proxyCountry": "ID",
  "renderJavascript": false,
  "category": "news",
  "tags": [
    "news",
    "detik",
    "indonesia",
    "headlines"
  ],
  "visibility": "public",
  "extractorConfig": {
    "version": "v1.0",
    "fields": [
      {
        "name": "pageTitle",
        "selector": "head title",
        "transforms": [
          "normalizeWhitespace"
        ]
      },
      {
        "name": "canonicalUrl",
        "selector": "head link[rel=\"canonical\"][href]",
        "extract": "attributeValue",
        "attributeName": "href"
      },
      {
        "name": "currentPage",
        "selector": ".pagination a.pagination__item--active",
        "transforms": [
          "toNumber"
        ]
      },
      {
        "name": "nextPageUrl",
        "selector": ".pagination a[onclick*=\"pagination Next\"][href]",
        "extract": "attributeValue",
        "attributeName": "href",
        "transforms": [
          "toAbsoluteUrl"
        ]
      },
      {
        "name": "sections",
        "selector": ".navbar-first li.nav__item",
        "isArray": true,
        "extract": "innerHTML",
        "subExtractor": {
          "fields": [
            {
              "name": "name",
              "selector": "a",
              "transforms": [
                "normalizeWhitespace",
                "nullIfEmpty"
              ],
              "required": true
            },
            {
              "name": "url",
              "selector": "a[href^=\"http\"]",
              "extract": "attributeValue",
              "attributeName": "href",
              "required": true
            }
          ]
        }
      },
      {
        "name": "stories",
        "selector": "#indeks-container article.list-content__item",
        "isArray": true,
        "extract": "innerHTML",
        "required": true,
        "includePosition": true,
        "subExtractor": {
          "fields": [
            {
              "name": "headline",
              "selector": "h3.media__title a",
              "transforms": [
                "normalizeWhitespace"
              ],
              "required": true
            },
            {
              "name": "url",
              "selector": "h3.media__title a[href]",
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                "toAbsoluteUrl"
              ],
              "required": true
            },
            {
              "name": "publishedAtUnix",
              "selector": ".media__date span[d-time]",
              "extract": "attributeValue",
              "attributeName": "d-time",
              "transforms": [
                "toNumber"
              ]
            },
            {
              "name": "publishedAtLabel",
              "selector": ".media__date span[title]",
              "extract": "attributeValue",
              "attributeName": "title"
            },
            {
              "name": "timeAgo",
              "selector": ".media__date span",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "image",
              "selector": ".media__image img[src]",
              "extract": "attributeValue",
              "attributeName": "src"
            }
          ]
        }
      }
    ]
  }
}

  "extractorConfig": {
    "version": "v1.0",
    "fields": [
      {
        "name": "name",
        "selector": "div[role=\"main\"][aria-label]",
        "extract": "attributeValue",
        "attributeName": "aria-label",
        "transforms": [
          "normalizeWhitespace",
          "nullIfEmpty"
        ],
        "required": true
      },
      {
        "name": "rating",
        "selector": "div.jANrlb div.fontDisplayLarge",
        "transforms": [
          "toNumber"
        ]
      },
      {
        "name": "reviewCount",
        "selector": [
          "div.jANrlb div.fontBodySmall",
          "div.jANrlb button.GQjSyb"
        ],
        "combineStrategy": "first",
        "transforms": [
          "extractNumber"
        ]
      },
      {
        "name": "ratingDistribution",
        "isArray": false,
        "subFields": [
          {
            "name": "stars5",
            "selector": "tr.BHOKXe:nth-child(1)[aria-label]",
            "extract": "attributeValue",
            "attributeName": "aria-label",
            "transforms": [
              {
                "after": ","
              },
              "extractNumber"
            ]
          },
          {
            "name": "stars4",
            "selector": "tr.BHOKXe:nth-child(2)[aria-label]",
            "extract": "attributeValue",
            "attributeName": "aria-label",
            "transforms": [
              {
                "after": ","
              },
              "extractNumber"
            ]
          },
          {
            "name": "stars3",
            "selector": "tr.BHOKXe:nth-child(3)[aria-label]",
            "extract": "attributeValue",
            "attributeName": "aria-label",
            "transforms": [
              {
                "after": ","
              },
              "extractNumber"
            ]
          },
          {
            "name": "stars2",
            "selector": "tr.BHOKXe:nth-child(4)[aria-label]",
            "extract": "attributeValue",
            "attributeName": "aria-label",
            "transforms": [
              {
                "after": ","
              },
              "extractNumber"
            ]
          },
          {
            "name": "stars1",
            "selector": "tr.BHOKXe:nth-child(5)[aria-label]",
            "extract": "attributeValue",
            "attributeName": "aria-label",
            "transforms": [
              {
                "after": ","
              },
              "extractNumber"
            ]
          }
        ]
      },
      {
        "name": "topics",
        "selector": "button.y8MoVd[data-index]",
        "isArray": true,
        "extract": "innerHTML",
        "subExtractor": {
          "fields": [
            {
              "name": "name",
              "selector": "span.K7m1mb",
              "transforms": [
                "normalizeWhitespace"
              ],
              "required": true
            },
            {
              "name": "mentions",
              "selector": "span.Pu1GXb",
              "transforms": [
                "extractNumber"
              ]
            }
          ]
        }
      },
      {
        "name": "reviews",
        "selector": "div.jftiEf[data-review-id]",
        "isArray": true,
        "extract": "innerHTML",
        "required": true,
        "subExtractor": {
          "fields": [
            {
              "name": "reviewId",
              "selector": "div[data-review-id]",
              "extract": "attributeValue",
              "attributeName": "data-review-id",
              "required": true
            },
            {
              "name": "author",
              "selector": "div.d4r55",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "authorInfo",
              "selector": "div.RfnDt",
              "transforms": [
                "normalizeWhitespace",
                "nullIfEmpty"
              ]
            },
            {
              "name": "rating",
              "selector": [
                "span.fzvQIb",
                "div.DU9Pgb"
              ],
              "combineStrategy": "first",
              "extract": "innerHTML",
              "allowedAttributes": [
                "aria-label"
              ],
              "transforms": [
                "extractNumber"
              ]
            },
            {
              "name": "date",
              "selector": [
                "span.rsqaWe",
                "span.xRkPPb"
              ],
              "combineStrategy": "first",
              "transforms": [
                "normalizeWhitespace",
                {
                  "split": " on "
                },
                "first"
              ]
            },
            {
              "name": "source",
              "selector": "span.qmhsmd",
              "transforms": [
                "normalizeWhitespace",
                "nullIfEmpty"
              ]
            },
            {
              "name": "text",
              "selector": "div.MyEned span.wiI7pd",
              "transforms": [
                "normalizeWhitespace",
                "nullIfEmpty"
              ]
            },
            {
              "name": "language",
              "selector": "div.MyEned[lang]",
              "extract": "attributeValue",
              "attributeName": "lang"
            },
            {
              "name": "details",
              "selector": "div.PBK6be",
              "isArray": true,
              "transforms": [
                "normalizeWhitespace",
                "compact"
              ]
            },
            {
              "name": "photos",
              "selector": "button.Tya61d[style]",
              "isArray": true,
              "extract": "attributeValue",
              "attributeName": "style",
              "transforms": [
                {
                  "between": [
                    "url(\"",
                    "\""
                  ]
                },
                "compact"
              ]
            },
            {
              "name": "ownerReply",
              "selector": "div.CDe7pd div.wiI7pd",
              "transforms": [
                "normalizeWhitespace",
                "nullIfEmpty"
              ]
            },
            {
              "name": "ownerReplyDate",
              "selector": "div.CDe7pd span.DZSIDd",
              "transforms": [
                "normalizeWhitespace"
              ]
            }
          ]
        }
      }
    ]
  }

{
  "name": "Google Maps - place reviews",
  "description": "Reviews of a Google Maps place (www.google.com/maps/place/...): the first reviews of the place's Reviews tab in Google's \"Most relevant\" order, with review id, author, rating, date, full text, language, detail ratings, photos and the owner's reply; plus the place name, average rating, review count, rating distribution and review topics. Renders the page in a browser (JavaScript tier). Pairs with @extracthub1/google-maps-search and @extracthub1/google-maps-place: feed the same placeUrl here.",
  "slug": "google-maps-reviews",
  "visibility": "public",
  "url": "https://www.google.com/maps/place/data=!4m4!3m3!1s0x8644ca6bc309e81b:0x1f1a903bbb66839!9m1!1b1?hl=en&gl=us",
  "method": "GET",
  "useProxy": true,
  "renderJavascript": true,
  "proxyCountry": "US",
  "category": "travel",
  "tags": [
    "google-maps",
    "reviews",
    "local-business",
    "maps",
    "ratings"
  ],

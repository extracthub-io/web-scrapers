{
  "name": "Trustpilot - company reviews",
  "description": "Trustpilot company review page: company name, TrustScore, review counts, rating distribution, categories and the reviews on the page (author, country, rating, title, text, dates, company reply) with the next page link.",
  "slug": "trustpilot-reviews",
  "url": "https://www.trustpilot.com/review/www.amazon.com",
  "method": "GET",
  "useProxy": true,
  "renderJavascript": false,
  "category": "ecommerce",
  "tags": [
    "trustpilot",
    "reviews",
    "ratings",
    "customer reviews",
    "reputation"
  ],
  "visibility": "public",
  "extractorConfig": {
    "version": "v1.0",
    "fields": [
      {
        "name": "companyName",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.displayName"
        ],
        "required": true,
        "transforms": [
          "normalizeWhitespace"
        ]
      },
      {
        "name": "domain",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.identifyingName"
        ]
      },
      {
        "name": "businessId",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.id"
        ]
      },
      {
        "name": "website",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.websiteUrl"
        ],
        "transforms": [
          "nullIfEmpty"
        ]
      },
      {
        "name": "trustScore",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.trustScore"
        ]
      },
      {
        "name": "stars",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.stars"
        ]
      },
      {
        "name": "reviewCount",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.numberOfReviews"
        ]
      },
      {
        "name": "reviewCountLast12Months",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.numberOfReviewsLast12Months"
        ]
      },
      {
        "name": "five",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.filters.reviewStatistics.ratings.five"
        ],
        "group": {
          "into": "ratingDistribution",
          "strategy": "nest"
        }
      },
      {
        "name": "four",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.filters.reviewStatistics.ratings.four"
        ],
        "group": {
          "into": "ratingDistribution",
          "strategy": "nest"
        }
      },
      {
        "name": "three",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.filters.reviewStatistics.ratings.three"
        ],
        "group": {
          "into": "ratingDistribution",
          "strategy": "nest"
        }
      },
      {
        "name": "two",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.filters.reviewStatistics.ratings.two"
        ],
        "group": {
          "into": "ratingDistribution",
          "strategy": "nest"
        }
      },
      {
        "name": "one",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.filters.reviewStatistics.ratings.one"
        ],
        "group": {
          "into": "ratingDistribution",
          "strategy": "nest"
        }
      },
      {
        "name": "categories",
        "selector": "a[href^=\"/categories/\"]",
        "extract": "textContent",
        "isArray": true,
        "transforms": [
          "normalizeWhitespace",
          "unique"
        ]
      },
      {
        "name": "isClaimed",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.isClaimed"
        ]
      },
      {
        "name": "country",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.countryCode"
        ]
      },
      {
        "name": "profileImage",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.businessUnit.profileImageUrl"
        ],
        "transforms": [
          "nullIfEmpty",
          "toAbsoluteUrl"
        ]
      },
      {
        "name": "currentPage",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.filters.pagination.currentPage"
        ]
      },
      {
        "name": "totalPages",
        "selector": "script#__NEXT_DATA__",
        "extract": "jsonContent",
        "jsonPaths": [
          "props.pageProps.filters.pagination.totalPages"
        ]
      },
      {
        "name": "reviews",
        "selector": "article[data-service-review-card-paper]:not([class*=\"carousel\"])",
        "extract": "innerHTML",
        "isArray": true,
        "includePosition": true,
        "required": true,
        "subExtractor": {
          "fields": [
            {
              "name": "reviewId",
              "selector": "a[href^=\"/reviews/\"]",
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                {
                  "after": "/reviews/"
                }
              ],
              "required": true
            },
            {
              "name": "reviewUrl",
              "selector": "a[href^=\"/reviews/\"]",
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                "toAbsoluteUrl"
              ]
            },
            {
              "name": "rating",
              "selector": "div[data-service-review-rating]",
              "extract": "attributeValue",
              "attributeName": "data-service-review-rating",
              "transforms": [
                "toNumber"
              ]
            },
            {
              "name": "title",
              "selector": "h2[data-service-review-title-typography]",
              "extract": "textContent",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "text",
              "selector": "p[data-service-review-text-typography]",
              "extract": "textContent",
              "textSeparator": "\n",
              "transforms": [
                "trim"
              ]
            },
            {
              "name": "author",
              "selector": "span[data-consumer-name-typography]",
              "extract": "textContent",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "authorCountry",
              "selector": "span[data-consumer-country-typography]",
              "extract": "textContent",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "authorReviewCount",
              "selector": "div[data-consumer-reviews-count]",
              "extract": "attributeValue",
              "attributeName": "data-consumer-reviews-count",
              "transforms": [
                "toNumber"
              ]
            },
            {
              "name": "publishedAt",
              "selector": "time[data-service-review-date-time-ago][datetime]",
              "extract": "attributeValue",
              "attributeName": "datetime"
            },
            {
              "name": "experienceDate",
              "selector": "div[data-testid=\"review-badge-date\"]",
              "extract": "textContent",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "labels",
              "selector": "div[data-testid^=\"review-badge-\"]:not([data-testid=\"review-badge-date\"]):not([data-testid=\"review-badge-description-link\"])",
              "extract": "textContent",
              "isArray": true,
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "replyText",
              "selector": "p[data-service-review-business-reply-text-typography]",
              "extract": "textContent",
              "textSeparator": "\n",
              "transforms": [
                "trim",
                "nullIfEmpty"
              ]
            },
            {
              "name": "replyDate",
              "selector": "time[data-service-review-business-reply-date-time-ago][datetime]",
              "extract": "attributeValue",
              "attributeName": "datetime"
            }
          ]
        }
      },
      {
        "name": "nextPageUrl",
        "selector": "a[name=\"pagination-button-next\"][href]",
        "extract": "attributeValue",
        "attributeName": "href",
        "transforms": [
          "toAbsoluteUrl"
        ]
      }
    ]
  }
}

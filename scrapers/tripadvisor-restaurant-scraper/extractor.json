{
  "name": "TripAdvisor - restaurant page",
  "description": "TripAdvisor restaurant page (Restaurant_Review): restaurant id, name, rating, review count, ranking, price range, cuisines, meal types, special diets, features, phone, menu link, address, coordinates, opening hours, image, breadcrumbs and the latest reviews (title, text, rating, visit date, link; no reviewer names).",
  "slug": "tripadvisor-restaurant",
  "url": "https://www.tripadvisor.com/Restaurant_Review-g60763-d1236281-Reviews-Club_A_Steakhouse-New_York_City_New_York.html",
  "method": "GET",
  "useProxy": true,
  "renderJavascript": false,
  "proxyCountry": "US",
  "category": "travel",
  "tags": [
    "tripadvisor",
    "travel",
    "restaurant",
    "reviews",
    "rating"
  ],
  "visibility": "public",
  "extractorConfig": {
    "version": "v1.0",
    "fields": [
      {
        "name": "restaurantId",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "url",
        "transforms": [
          {
            "between": [
              "-d",
              "-Reviews"
            ]
          }
        ],
        "required": true
      },
      {
        "name": "name",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "name",
        "transforms": [
          "decodeHtml"
        ],
        "required": true
      },
      {
        "name": "rating",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "aggregateRating.ratingValue",
        "transforms": [
          "toNumber"
        ]
      },
      {
        "name": "reviewCount",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "aggregateRating.reviewCount",
        "transforms": [
          "toNumber"
        ]
      },
      {
        "name": "ranking",
        "selector": "[data-test-target=\"restaurant-detail-info\"] a[href^=\"/Restaurants-g\"] span",
        "transforms": [
          "normalizeWhitespace"
        ]
      },
      {
        "name": "rankPosition",
        "selector": "[data-test-target=\"restaurant-detail-info\"] a[href^=\"/Restaurants-g\"] span",
        "transforms": [
          {
            "between": [
              "#",
              " of"
            ]
          },
          "toInteger"
        ]
      },
      {
        "name": "rankTotal",
        "selector": "[data-test-target=\"restaurant-detail-info\"] a[href^=\"/Restaurants-g\"] span",
        "transforms": [
          {
            "between": [
              "of ",
              " "
            ]
          },
          "toInteger"
        ]
      },
      {
        "name": "priceRange",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "priceRange"
      },
      {
        "name": "cuisines",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "servesCuisine[*]"
      },
      {
        "name": "details",
        "selector": ".iPiKu",
        "extract": "innerHTML",
        "isArray": true,
        "subExtractor": {
          "fields": [
            {
              "name": "label",
              "selector": ".csBwo",
              "transforms": [
                "normalizeWhitespace"
              ],
              "required": true
            },
            {
              "name": "value",
              "selector": ".AWdfh:not(.avBIb)",
              "transforms": [
                "normalizeWhitespace"
              ],
              "required": true
            }
          ]
        }
      },
      {
        "name": "features",
        "selector": ".KPjho .TSYox",
        "isArray": true,
        "transforms": [
          "normalizeWhitespace"
        ]
      },
      {
        "name": "acceptsReservations",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "acceptsReservations"
      },
      {
        "name": "telephone",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "telephone"
      },
      {
        "name": "menuUrl",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "hasMenu"
      },
      {
        "name": "streetAddress",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "address.streetAddress",
        "transforms": [
          "decodeHtml"
        ]
      },
      {
        "name": "city",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "address.addressLocality"
      },
      {
        "name": "region",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "address.addressRegion"
      },
      {
        "name": "postalCode",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "address.postalCode"
      },
      {
        "name": "country",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "address.addressCountry.name"
      },
      {
        "name": "latitude",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "geo.latitude"
      },
      {
        "name": "longitude",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "geo.longitude"
      },
      {
        "name": "openingHours",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "openingHoursSpecification[*]",
        "subFields": [
          {
            "name": "day",
            "jsonPath": "dayOfWeek",
            "required": true
          },
          {
            "name": "opens",
            "jsonPath": "opens"
          },
          {
            "name": "closes",
            "jsonPath": "closes"
          }
        ]
      },
      {
        "name": "image",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "image"
      },
      {
        "name": "breadcrumbs",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "itemListElement[*].name"
      },
      {
        "name": "reviews",
        "selector": "[data-test-target=\"HR_CC_CARD\"]",
        "extract": "innerHTML",
        "isArray": true,
        "includePosition": true,
        "subExtractor": {
          "fields": [
            {
              "name": "title",
              "selector": "[data-test-target=\"review-title\"]",
              "transforms": [
                "normalizeWhitespace"
              ],
              "required": true
            },
            {
              "name": "text",
              "selector": "[data-test-target=\"review-body\"] div[style*=\"line-clamp\"]",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "rating",
              "selector": "svg[data-automation=\"bubbleRatingImage\"] title",
              "transforms": [
                {
                  "before": " of"
                },
                "toNumber"
              ]
            },
            {
              "name": "url",
              "selector": "[data-test-target=\"review-title\"] a[href]",
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                "toAbsoluteUrl"
              ]
            }
          ]
        }
      },
      {
        "name": "url",
        "selector": "script[type=\"application/ld+json\"]",
        "extract": "jsonContent",
        "jsonPath": "url",
        "required": true
      }
    ]
  }
}
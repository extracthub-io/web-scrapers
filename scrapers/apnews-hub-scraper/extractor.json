{
  "name": "AP News - hub page",
  "description": "Stories listed on an AP News hub (topic / section) page (apnews.com/hub/<topic>): position, headline, link, summary, published and updated time, authors, image and comment count, plus the page title, description and canonical URL, and the sections of the navigation bar (World, U.S., Politics, Sports, ...). Plain fetch.",
  "slug": "apnews-hub",
  "url": "https://apnews.com/hub/technology",
  "method": "GET",
  "useProxy": true,
  "renderJavascript": false,
  "proxyCountry": "US",
  "category": "news",
  "tags": [
    "news",
    "apnews",
    "headlines",
    "news-list"
  ],
  "visibility": "public",
  "extractorConfig": {
    "version": "v1.0",
    "fields": [
      {
        "name": "title",
        "selector": "h1.PageList-header-title",
        "extract": "textContent",
        "transforms": [
          "normalizeWhitespace"
        ]
      },
      {
        "name": "pageTitle",
        "selector": "title",
        "extract": "textContent",
        "transforms": [
          "normalizeWhitespace"
        ]
      },
      {
        "name": "description",
        "selector": "meta[name=\"description\"][content]",
        "extract": "attributeValue",
        "attributeName": "content"
      },
      {
        "name": "canonicalUrl",
        "selector": "link[rel=\"canonical\"][href]",
        "extract": "attributeValue",
        "attributeName": "href"
      },
      {
        "name": "sections",
        "selector": ".Page-header.desktop-header .MainNavigation-items > .MainNavigation-items-item:not([data-morebutton])",
        "isArray": true,
        "extract": "innerHTML",
        "subExtractor": {
          "fields": [
            {
              "name": "name",
              "selector": "a.AnClick-MainNav",
              "transforms": [
                "normalizeWhitespace",
                "nullIfEmpty"
              ],
              "required": true
            },
            {
              "name": "url",
              "selector": "a.AnClick-MainNav[href]",
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                "toAbsoluteUrl"
              ],
              "required": true
            }
          ]
        }
      },
      {
        "name": "stories",
        "selector": "main .PageList-items-item",
        "isArray": true,
        "extract": "innerHTML",
        "includePosition": true,
        "required": true,
        "subExtractor": {
          "fields": [
            {
              "name": "headline",
              "selector": ".PagePromo-title .PagePromoContentIcons-text",
              "extract": "textContent",
              "transforms": [
                "normalizeWhitespace"
              ],
              "required": true
            },
            {
              "name": "url",
              "selector": ".PagePromo-title a[href]",
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                "toAbsoluteUrl"
              ],
              "required": true
            },
            {
              "name": "summary",
              "selector": ".PagePromo-description .PagePromoContentIcons-text",
              "extract": "textContent",
              "transforms": [
                "normalizeWhitespace"
              ]
            },
            {
              "name": "publishedAtMs",
              "selector": ".PagePromo[data-posted-date-timestamp]",
              "extract": "attributeValue",
              "attributeName": "data-posted-date-timestamp",
              "transforms": [
                "toNumber"
              ]
            },
            {
              "name": "updatedAtMs",
              "selector": ".PagePromo[data-updated-date-timestamp]",
              "extract": "attributeValue",
              "attributeName": "data-updated-date-timestamp",
              "transforms": [
                "toNumber"
              ]
            },
            {
              "name": "authors",
              "selector": ".PagePromo-author a",
              "isArray": true,
              "extract": "textContent",
              "transforms": [
                "normalizeWhitespace",
                "compact"
              ]
            },
            {
              "name": "authorUrls",
              "selector": ".PagePromo-author a[href]",
              "isArray": true,
              "extract": "attributeValue",
              "attributeName": "href",
              "transforms": [
                "toAbsoluteUrl"
              ]
            },
            {
              "name": "image",
              "selector": ".PagePromo-media img[src]",
              "extract": "attributeValue",
              "attributeName": "src"
            },
            {
              "name": "imageAlt",
              "selector": ".PagePromo-media img[alt]",
              "extract": "attributeValue",
              "attributeName": "alt"
            },
            {
              "name": "commentCount",
              "selector": ".PagePromo-commentCount .CommentCount-template",
              "extract": "textContent",
              "transforms": [
                "extractNumber"
              ]
            }
          ]
        }
      }
    ]
  }
}

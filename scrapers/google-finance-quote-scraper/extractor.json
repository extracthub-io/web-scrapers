{
  "name": "Google Finance - stock quote",
  "description": "Google Finance quote pages (google.com/finance/quote/<SYMBOL>:<EXCHANGE>?hl=en): company name, ticker, symbol, exchange, price, change and change %, market status / time, currency, after-hours / pre-market price, the key stats grid (open, high, low, market cap, average volume, volume, dividend yield, quarterly dividend, ex-dividend date, P/E, 52-week high / low, EPS, beta, shares outstanding, employees), company profile and About rows (CEO, founded, headquarters, sector, industry, website), analyst ratings (buy / hold / sell) and 12-month price targets (highest, average, lowest), latest news (title, link, source, time) and related stocks.",
  "slug": "google-finance-quote",
  "url": "https://www.google.com/finance/quote/AAPL:NASDAQ?hl=en",
  "method": "GET",
  "useProxy": true,
  "renderJavascript": false,
  "proxyCountry": "US",
  "category": "finance",
  "tags": [
    "google finance",
    "stocks",
    "stock quote",
    "market data",
    "finance",
    "analyst ratings",
    "stock news"
  ],
  "visibility": "public",
  "extractorConfig": {
    "version": "v1.0",

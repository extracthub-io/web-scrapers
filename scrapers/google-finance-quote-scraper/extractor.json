        "name": "name",
        "selector": "div[jsname=\"AS5Pxb\"] .gO24Ff",
        "transforms": [
          "normalizeWhitespace"
        ],
        "required": true
      },
      {
        "name": "ticker",
        "selector": ".JV7gl[title]",
        "extract": "attributeValue",
        "attributeName": "title"
      },
      {
        "name": "symbol",
        "selector": ".JV7gl[title]",
        "extract": "attributeValue",
        "attributeName": "title",
        "transforms": [
          {
            "before": ":"
          }
        ]
      },
      {
        "name": "exchange",
        "selector": ".JV7gl[title]",
        "extract": "attributeValue",
        "attributeName": "title",
        "transforms": [
          {
            "after": ":"
          }
        ]
      },
      {
        "name": "price",
        "selector": "div[jsname=\"AS5Pxb\"] .N6SYTe span[jsname=\"Pdsbrc\"]",
        "transforms": [
          "extractPrice"
        ],
        "required": true
      },
      {
        "name": "priceText",
        "selector": "div[jsname=\"AS5Pxb\"] .N6SYTe span[jsname=\"Pdsbrc\"]",
        "transforms": [
          "normalizeWhitespace"
        ]
      },
      {
        "name": "changePercent",
        "selector": "div[jsname=\"AS5Pxb\"] .ujg0He span[jsname=\"vY9t3b\"]",
        "transforms": [
          "toNumber"
        ]
      },
      {
        "name": "change",
        "selector": "div[jsname=\"AS5Pxb\"] .ujg0He span[jsname=\"xnruHf\"]",
        "transforms": [
          "toNumber"
        ]
      },
      {
        "name": "marketStatus",
        "selector": "div[jsname=\"AS5Pxb\"] .jZZ2de",
        "transforms": [
          "normalizeWhitespace",
          {
            "before": " · "
          }
        ]
      },
      {
        "name": "currency",
        "selector": "div[jsname=\"AS5Pxb\"] .jZZ2de",
        "transforms": [
          "normalizeWhitespace",
          {
            "after": " · "
          }
        ]
      },
      {
        "name": "extendedPrice",

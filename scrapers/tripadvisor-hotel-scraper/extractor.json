{
  "name": "TripAdvisor - hotel page",
  "description": "TripAdvisor hotel page (Hotel_Review): hotel id, name, rating, reviews count, ranking, hotel class, price range, featured offer, address, coordinates, phone, website, amenities, description, image, category breadcrumbs and the latest reviews (title, text, rating, link; no reviewer names).",
  "slug": "tripadvisor-hotel",
  "url": "https://www.tripadvisor.com/Hotel_Review-g60763-d1776857-Reviews-The_Langham_New_York_Fifth_Avenue-New_York_City_New_York.html",
  "method": "GET",
  "useProxy": true,
  "renderJavascript": false,
  "proxyCountry": "US",
  "category": "travel",
  "tags": [
    "tripadvisor",
    "travel",
    "hotel",
    "reviews",
    "rating"
  ],
  "visibility": "public",
  "extractorConfig": {
    "version": "v1.0",
    "fields": [
      { "name": "hotelId", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "url", "transforms": [{ "between": ["-d", "-Reviews"] }], "required": true },
      { "name": "name", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "name", "transforms": ["decodeHtml"], "required": true },
      { "name": "rating", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "aggregateRating.ratingValue", "transforms": ["toNumber"] },
      { "name": "reviewCount", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "aggregateRating.reviewCount", "transforms": ["toNumber"] },
      { "name": "ranking", "selector": "meta[name=\"description\"][content]", "extract": "attributeValue", "attributeName": "content", "transforms": [{ "between": ["ranked ", " and rated"] }] },
      { "name": "hotelClass", "selector": "[data-automation=\"affiliateStarRating\"]", "transforms": [{ "before": " of" }, "toNumber"] },
      { "name": "priceRange", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "priceRange", "transforms": [{ "before": " (" }, "trim"] },
      { "name": "offerPrice", "selector": "[data-automation=\"hr-offer-price\"]", "transforms": ["extractPrice"] },
      { "name": "offerProvider", "selector": "img[data-automation=\"hr-offer-provider\"][alt]", "extract": "attributeValue", "attributeName": "alt" },
      { "name": "telephone", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "telephone" },
      { "name": "website", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "sameAs" },
      { "name": "streetAddress", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "address.streetAddress", "transforms": ["decodeHtml"] },
      { "name": "city", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "address.addressLocality" },
      { "name": "region", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "address.addressRegion" },
      { "name": "postalCode", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "address.postalCode" },
      { "name": "country", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "address.addressCountry.name" },
      { "name": "latitude", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "geo.latitude" },
      { "name": "longitude", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "geo.longitude" },
      { "name": "amenities", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "amenityFeatures[*].name" },
      { "name": "description", "selector": "[data-automation=\"aboutTabDescription\"] div[style*=\"max-height\"]", "transforms": ["normalizeWhitespace"] },
      { "name": "image", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "image" },
      { "name": "breadcrumbs", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "itemListElement[*].name" },
      {
        "name": "reviews",
        "selector": "[data-test-target=\"HR_CC_CARD\"]",
        "extract": "innerHTML",
        "isArray": true,
        "includePosition": true,
        "subExtractor": {
          "fields": [
            { "name": "title", "selector": "[data-test-target=\"review-title\"]", "transforms": ["normalizeWhitespace"], "required": true },
            { "name": "text", "selector": "div[style*=\"line-clamp\"]", "transforms": ["normalizeWhitespace"] },
            { "name": "rating", "selector": "svg[data-automation=\"bubbleRatingImage\"] title", "transforms": [{ "before": " of" }, "toNumber"] },
            { "name": "url", "selector": "[data-test-target=\"review-title\"] a[href]", "extract": "attributeValue", "attributeName": "href", "transforms": ["toAbsoluteUrl"] }
          ]
        }
      },
      { "name": "url", "selector": "script[type=\"application/ld+json\"]", "extract": "jsonContent", "jsonPath": "url", "required": true }
    ]
  }
}
